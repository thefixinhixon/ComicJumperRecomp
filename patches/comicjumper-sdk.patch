+// --- Wait diagnostics (--diag_wait_stats): per-thread wait/set call rates, logged every 5 s ---
+#include <map>
+#include <mutex>
+#include <chrono>
+REXCVAR_DEFINE_BOOL(diag_wait_stats, false, "Diagnostics", "Log guest wait call stats every 5 s");
+namespace {
+void DiagWait(const char* kind, const uint64_t* timeout, uint32_t result, bool alertable) {
+  if (!REXCVAR_GET(diag_wait_stats)) return;
+  static std::mutex m;
+  static std::map<std::string, uint64_t> counts;
+  static auto last = std::chrono::steady_clock::now();
+  std::string t = !timeout ? "inf" : std::to_string(int64_t(*timeout) / -10000) + "ms";
+  char tn[32] = "?";
+  pthread_getname_np(pthread_self(), tn, sizeof(tn));
+  std::string key = std::string(tn) + " " + kind + " to=" + t +
+                    (alertable ? " A" : "") + " r=" + std::to_string(result);
+  std::lock_guard<std::mutex> lock(m);
+  counts[key]++;
+  auto now = std::chrono::steady_clock::now();
+  if (now - last > std::chrono::seconds(5)) {
+    double secs = std::chrono::duration<double>(now - last).count();
+    for (auto& [k, v] : counts) if (v / secs > 50) REXLOG_INFO("waitstat {:8.0f}/s {}", v / secs, k);
+    counts.clear(); last = now;
+  }
+}
